rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function groupDoc(gid) { return get(/databases/$(database)/documents/groups/$(gid)); }

    // Grupo: só membros leem. Quem tem um convite válido pode se adicionar.
    match /groups/{gid} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && request.resource.data.members == [me()]
        && request.resource.data.memberInfo.keys().hasOnly([me()]);
      allow update: if signedIn() && (
        // membro editando (sem trocar o dono)
        (me() in resource.data.members && request.resource.data.owner == resource.data.owner)
        ||
        // entrando no grupo com convite
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'lastInvite'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members).hasOnly([me()])
          && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([me()])
          && get(/databases/$(database)/documents/invites/$(request.resource.data.lastInvite)).data.gid == gid)
      );

      // Conversa: só quem está nela vê. Só membros do grupo entram.
      match /sessions/{sid} {
        allow read: if signedIn() && me() in resource.data.members;
        allow create: if signedIn()
          && request.resource.data.createdBy == me()
          && me() in request.resource.data.members
          && groupDoc(gid).data.members.hasAll(request.resource.data.members);
        allow update: if signedIn()
          && me() in resource.data.members
          && groupDoc(gid).data.members.hasAll(request.resource.data.members)
          && request.resource.data.createdBy == resource.data.createdBy;

        match /messages/{mid} {
          function inSession() {
            return me() in get(/databases/$(database)/documents/groups/$(gid)/sessions/$(sid)).data.members;
          }
          allow read: if signedIn() && inSession();
          allow create: if signedIn() && inSession() && request.resource.data.from == me();
        }
      }
    }

    // Chamadas: só quem liga e quem recebe veem. Só entre participantes da mesma conversa.
    match /calls/{cid} {
      function sess(d) { return get(/databases/$(database)/documents/groups/$(d.gid)/sessions/$(d.sid)).data.members; }
      function party(d) { return me() == d.from || me() == d.to; }
      allow read: if signedIn() && party(resource.data);
      allow create: if signedIn()
        && request.resource.data.from == me()
        && me() in sess(request.resource.data)
        && request.resource.data.to in sess(request.resource.data);
      allow update, delete: if signedIn() && party(resource.data);
      match /cand/{x} {
        allow read, create: if signedIn() && party(get(/databases/$(database)/documents/calls/$(cid)).data);
      }
    }

    // Usuário: guarda os tokens de notificação do próprio aparelho.
    match /users/{u} {
      allow read, write: if signedIn() && me() == u;
    }

    // Convites: quem tem o código consegue ler um convite (mas não listar todos).
    match /invites/{token} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.by == me()
        && me() in groupDoc(request.resource.data.gid).data.members;
    }
  }
}
